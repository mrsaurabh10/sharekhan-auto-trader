SPRING_PROFILES_ACTIVE=user-test
SERVER_PORT=8080
APP_TELEGRAM_WEBHOOK_SECRET=replace-me

# Local PostgreSQL instance. Use a unique, long random value for the password.
# Do not commit the corresponding .env file.
POSTGRES_DB=sharekhan
POSTGRES_USER=sharekhan_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# Leave false until the PostgreSQL audit POC has been tested.
APP_AUDIT_POSTGRES_ENABLED=false
APP_AUDIT_POSTGRES_BACKFILL_ON_STARTUP=false
APP_BACKTEST_POSTGRES_ENABLED=false
APP_BACKTEST_POSTGRES_BACKFILL_ON_STARTUP=false
APP_USER_BROKER_POSTGRES_ENABLED=false
APP_USER_BROKER_POSTGRES_BACKFILL_ON_STARTUP=false
APP_TRADING_STATE_POSTGRES_ENABLED=false
APP_TRADING_STATE_POSTGRES_BACKFILL_ON_STARTUP=false
APP_CONFIGURATION_POSTGRES_ENABLED=false
APP_CONFIGURATION_POSTGRES_BACKFILL_ON_STARTUP=false
APP_REFERENCE_DATA_POSTGRES_ENABLED=false
APP_REFERENCE_DATA_POSTGRES_BACKFILL_ON_STARTUP=false

# Set these together only after the complete PostgreSQL migration has been verified.
APP_DATABASE_POSTGRES_PRIMARY=false
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sharekhan
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=sharekhan_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password

DATA_DIR=/root/data
LOG_DIR=/root/logs
DUMP_DIR=/root/dumps

JAVA_OPTS=-Xms128m -Xmx384m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/dumps -Xlog:gc*:file=/app/logs/gc.log:utctime

ENABLE_DEBUG=false
ENABLE_JMX=false
DEBUG_PORT=5005
JMX_PORT=9010
JMX_RMI_HOSTNAME=127.0.0.1
